# ===== 前端环境变量 =====
# Agent 传输层：mock=前端模拟（默认，无需后端）| sse=走后端 SSE
VITE_AGENT_TRANSPORT=mock

# 仅 sse 模式需要：留空表示同源请求 /api/agent/stream（本地由 Vite 代理到 3000）
VITE_AGENT_API_URL=/api/agent/stream

# 留空表示同源请求（Vite / Nginx 代理）；直连后端时填 http://127.0.0.1:3000
VITE_API_BASE_URL=

# 本地连接真实后端的最小配置：
# VITE_AGENT_TRANSPORT=sse
# VITE_AGENT_API_URL=/api/agent/stream
# VITE_API_BASE_URL=
