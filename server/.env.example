# ===== 数据库 =====
# 默认值与 server/scripts/init-mysql.sql 一致
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=retailos
DB_PASSWORD=retailos_dev
DB_NAME=retailos
# 生产环境必须保持 false，结构变更统一走 migration
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# ===== 鉴权 =====
# 生产环境请替换为 32 位以上的随机字符串
JWT_SECRET=change-me

# ===== 经营助手模型 =====
# rule=规则场景（默认，无外部依赖）
# stub=本地确定性模型（自动化测试）
# openai / deepseek / modelscope = OpenAI 兼容接口
LLM_PROVIDER=rule
# 仅在启用真实模型时填写，例如：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ===== 服务监听（可选，默认 127.0.0.1:3000） =====
# HOST=127.0.0.1
# PORT=3000
