# ===== 数据库 =====
# 默认值与 server/scripts/init-mysql.sql 一致
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=retailos
DB_PASSWORD=retailos_dev
DB_NAME=retailos
# 生产环境必须保持 false，结构变更统一走 migration
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true

# ===== 鉴权 =====
# 生产环境请替换为 32 位以上的随机字符串
JWT_SECRET=change-me

# ===== 经营助手模型 =====
# rule=规则场景（默认，无外部依赖）
# stub=本地确定性模型（自动化测试）
# openai / deepseek / modelscope = OpenAI 兼容接口
LLM_PROVIDER=rule
# 仅在启用真实模型时填写，例如：
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ===== 服务监听（可选，默认 127.0.0.1:3000） =====
# HOST=127.0.0.1
# PORT=3000

# ===== 安全（可选，默认值适合本地开发） =====
# 允许的前端来源，逗号分隔；生产环境必须显式配置
# CORS_ORIGINS=https://retail.example.com
# 位于 Nginx 等反向代理后时设为 1，用于取真实客户端 IP
# TRUST_PROXY=1
# 全局限流：窗口毫秒数与窗口内最大请求数
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=1200
# JWT 有效期
# JWT_EXPIRES_IN=8h
# 指标接口令牌；留空表示不校验（建议生产设置或在网关层限制）
# METRICS_TOKEN=
