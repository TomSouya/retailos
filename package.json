{
  "name": "retailos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "npm --prefix server run start",
    "server:smoke": "npm --prefix server run smoke",
    "test:server": "npm --prefix server run test",
    "db:reset": "npm --prefix server run reset:demo -- --yes",
    "db:backup": "powershell -ExecutionPolicy Bypass -File scripts/backup-db.ps1",
    "db:restore": "powershell -ExecutionPolicy Bypass -File scripts/restore-db.ps1",
    "db:archive-audit": "npm --prefix server run archive:audit",
    "db:reconcile": "npm --prefix server run reconcile",
    "e2e": "node scripts/run-e2e-clean.mjs scripts/verify.mjs",
    "e2e:phase2": "node scripts/run-e2e-clean.mjs scripts/verify-phase2.mjs",
    "e2e:phase3": "node scripts/run-e2e-clean.mjs scripts/verify-phase3.mjs",
    "e2e:concurrency": "node scripts/run-e2e-clean.mjs scripts/verify-concurrency.mjs",
    "verify:agent": "node scripts/verify-agent-contracts.mjs",
    "check:arch": "node scripts/check-architecture.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "security:check": "node scripts/security-check.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.21.1",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.8",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "puppeteer-core": "^25.18.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.6"
  }
}
